{
  "name": "structura",
  "private": true,
  "author": "clark.joao@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clarkjoao/Structura"
  },
  "homepage": "https://github.com/clarkjoao/Structura",
  "bugs": {
    "url": "https://github.com/clarkjoao/Structura/issues"
  },
  "keywords": [
    "architecture",
    "diagram",
    "diagramming",
    "c4-model",
    "modeling-tool",
    "react-flow",
    "software-architecture"
  ],
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run copy-404",
    "copy-404": "node -e \"require('fs').copyFileSync('public/404.html','dist/404.html')\"",
    "build:dev": "vite build --mode development",
    "build:plugins": "node tools/build-with-plugins.mjs",
    "proxy:install": "npm --prefix server install",
    "proxy:dev": "npm --prefix server run dev",
    "proxy": "npm run proxy:install && npm run proxy:dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "plugins:sync-check": "node plugins/structura-plugin-leanix/scripts/sync-types.mjs --check && node plugins/structura-plugin-leanix/scripts/sync-shared.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:stress": "cypress run --spec 'cypress/e2e/stress-*'",
    "cy:run:stress:headed": "cypress run --spec 'cypress/e2e/stress-*' --browser chrome --headed",
    "cy:report:merge": "mochawesome-merge cypress/reports/mochawesome/*.json -o cypress/reports/mochawesome/merged.json",
    "cy:report:html": "marge cypress/reports/mochawesome/merged.json -o cypress/reports/mochawesome/html -f index --charts --inline",
    "cy:report": "npm run cy:report:merge && npm run cy:report:html"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.16",
    "@assistant-ui/react-markdown": "^0.14.12",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xyflow/react": "^12.10.1",
    "aws-react-icons": "^3.3.0",
    "azure-react-icons": "^0.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "elkjs": "^0.12.0",
    "framer-motion": "^13.1.0",
    "gcp-icons": "^1.0.6",
    "highlight.js": "^11.12.0",
    "i18next": "^25.10.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.16",
    "jszip": "^3.10.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.28.0",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.55.1",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.20.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.1"
  }
}
