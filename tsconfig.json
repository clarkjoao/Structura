{
  /*
   * The app project itself, not a solution file.
   *
   * This used to be `{ "files": [], "references": [...] }`, which is the
   * canonical shape for a multi-project repo — and it made `tsc --noEmit` here
   * compile an empty program and exit 0, whatever was wrong in `src`. Only
   * `tsc -b` checked anything, so a bare `tsc --noEmit` reported a green gate
   * over a broken tree.
   *
   * Extending the app project rather than restating its options keeps one
   * source of truth: this file cannot drift from what `tsconfig.app.json`
   * compiles, because it *is* what it compiles. `tsconfig.node.json` stays a
   * project of its own — vite.config.ts is checked against a Node lib with no
   * DOM, which is the point of keeping it separate — and `npm run typecheck`
   * runs both.
   */
  "extends": "./tsconfig.app.json"
}
