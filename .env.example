# DefectDojo Integration (optional)
# Set to "true" to enable the DefectDojo import panel in the Service Registry.
# Note: DefectDojo must be configured to allow CORS requests from this app's origin.
VITE_ENABLE_DEFECTDOJO=true

# GitHub Integration (optional)
# Set to "true" to enable the GitHub import panel in the Service Registry.
VITE_ENABLE_GITHUB_IMPORT=true

# Embed Routing Bypass (optional)
# Set to "true" to bypass the routing and directly open the embed page.
# This is useful for embedding the diagram in a iframe.
VITE_EMBED_ROUTING_BYPASS=false

# Seeds (optional)
# Set to "true" to disable demo/seed diagrams on a fresh store.
VITE_DISABLE_SEEDS=false

# Proxy Reverse (optional)
# Set to "true" to enable the proxy reverse.
PROXY_REVERSE_INSECURE_TLS=true
# Proxy Reverse
PROXY_REVERSE_PORT=3000
PROXY_REVERSE_DEFECTDOJO_URL=https://demo.defectdojo.org

# GitHub API via proxy (opcional, mas necessário para a flag vinda do proxy)
PROXY_REVERSE_GITHUB_URL=https://api.github.com
#Optional: GitHub API token
# PROXY_REVERSE_GITHUB_API_TOKEN=

# Optional: Proxy for internet access
# PROXY_REVERSE_INTERNET_HTTP_PROXY=http://127.0.0.1:3000
# PROXY_REVERSE_INTERNET_HTTPS_PROXY=http://127.0.0.1:3000
