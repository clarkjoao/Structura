# DefectDojo Integration (optional)
# Set to "true" to enable the DefectDojo import panel in the Service Registry.
# Note: DefectDojo must be configured to allow CORS requests from this app's origin.
VITE_ENABLE_DEFECTDOJO=true

# GitHub Integration (optional)
# Set to "true" to enable the GitHub import panel in the Service Registry.
VITE_ENABLE_GITHUB_IMPORT=true

# Seeds (optional)
# Set to "true" to disable demo/seed diagrams on a fresh store.
VITE_DISABLE_SEEDS=false

# ─── Proxy Server ────────────────────────────────────────────────────────────
# These are used by the server when running in development mode.

# Allow insecure TLS (for corporate networks with self-signed certificates)
PROXY_REVERSE_INSECURE_TLS=true

# Corporate HTTP/HTTPS proxy for outbound requests (optional)
# PROXY_REVERSE_INTERNAL_HTTP_PROXY=http://proxy.company.com:8080
# PROXY_REVERSE_INTERNAL_HTTPS_PROXY=http://proxy.company.com:8080

# ─── F6b release gate (element registry) ─────────────────────────────────────
# Persisting `cloudServiceId` (persist schema v13) is a deliberate release
# decision, not something a green branch implies: a client that writes it
# diverges on collaboration checksums from one that still writes the legacy
# awsService/gcpService/azureService fields, and there is no component-schema
# version on the wire to negotiate it.
#
# `npm run build` REFUSES to produce a bundle unless this is "true".
# Dev and tests are unaffected. See docs/adr/0010-element-registry.md.
VITE_ENABLE_CLOUD_SERVICE_ID_WRITE=false
