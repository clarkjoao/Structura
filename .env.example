# The GitHub and DefectDojo importers in the Service Registry are always available.
# DefectDojo must be configured to allow CORS requests from this app's origin.

# Seeds (optional)
# Set to "true" to disable demo/seed diagrams on a fresh store.
VITE_DISABLE_SEEDS=false

# Embedded viewer (optional)
# Comma-separated origins allowed to post a diagram into /viewer (STRUCTURA_LOAD). Empty = any origin;
# only the embedding page can post either way. See docs/guides/embedding.md.
# VITE_EMBED_ALLOWED_ORIGINS=https://docs.example.com

# ─── Request proxy (optional) ────────────────────────────────────────────────
# The assistant's "proxy" mode and the GitHub/DefectDojo integrations can route requests through
# an HTTP proxy you run yourself (Structura does not ship one). Its base URL; "/proxy" is appended.
# VITE_LLM_PROXY_URL=http://localhost:3000
