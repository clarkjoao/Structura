{
  "name": "structura-plugin-leanix",
  "version": "1.0.0",
  "description": "Export diagrams to Leanix ITSM",
  "main": "dist/plugin.js",
  "type": "module",
  "scripts": {
    "build": "npm run sync-types && vite build",
    "dev": "vite build --watch",
    "sync-types": "node scripts/sync-types.mjs",
    "sync-types:check": "node scripts/sync-types.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@xyflow/react": "^12.0.0",
    "react": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  }
}
