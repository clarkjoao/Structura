{
  "name": "structura-plugin-opscr",
  "version": "0.5.0",
  "description": "Import opscr architecture-as-code manifests as a laid-out Structura diagram",
  "main": "dist/plugin.js",
  "type": "module",
  "scripts": {
    "build": "npm run sync-types && npm run sync-shared && vite build",
    "sync-types": "node scripts/sync-types.mjs",
    "sync-types:check": "node scripts/sync-types.mjs --check",
    "sync-shared": "node scripts/sync-shared.mjs",
    "sync-shared:check": "node scripts/sync-shared.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
