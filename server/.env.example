# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
WS_PATH=/ws

# ── HTTPS (optional — omit to use plain HTTP behind a reverse proxy) ──────────
# SSL_KEY_PATH=/etc/ssl/private/server.key
# SSL_CERT_PATH=/etc/ssl/certs/server.crt

# ── Collaboration ────────────────────────────────────────────────────────────
# Shared room storage. Unset: one instance, rooms in memory. Set it to run several relays.
# REDIS_URL=redis://localhost:6379
# REDIS_NAMESPACE=
# COLLAB_HOST_GRACE_MS=30000
# COLLAB_MAX_PARTICIPANTS=50
